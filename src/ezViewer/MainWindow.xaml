<Window x:Class="EzViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EzViewer.Views"
        Title="ezViewer" Width="1280" Height="820" MinWidth="760" MinHeight="480"
        Icon="/Assets/ezViewer.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        InputMethod.IsInputMethodEnabled="False"
        AllowDrop="True"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp"
        PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop"
        Deactivated="Window_Deactivated" Closing="Window_Closing">
    <Grid>
        <views:LibraryView x:Name="Library" />
        <views:ReaderView x:Name="Reader" Visibility="Collapsed" />

        <Grid x:Name="HelpOverlay" Visibility="Collapsed" Background="{StaticResource OverlayBrush}"
              MouseLeftButtonDown="HelpOverlay_MouseLeftButtonDown">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="28,22,28,24" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11"
                                Content="&#xE711;" ToolTip="关闭 (Esc)" Click="HelpClose_Click" />
                        <TextBlock Text="快捷键" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock x:Name="SettingsPathText" DockPanel.Dock="Bottom" Margin="0,16,0,0" FontSize="11"
                               Foreground="{StaticResource FaintTextBrush}" TextWrapping="Wrap" />
                    <Grid x:Name="HelpGrid" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
