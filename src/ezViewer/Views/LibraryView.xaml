<UserControl x:Class="EzViewer.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lib="clr-namespace:EzViewer.Library"
             xmlns:views="clr-namespace:EzViewer.Views"
             Background="{StaticResource WindowBrush}">
    <UserControl.Resources>
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="10" Padding="6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource PressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TileTemplate" DataType="{x:Type lib:ComicTile}">
            <Button Style="{StaticResource TileButton}" Margin="6,4" Click="Tile_Click"
                    ToolTip="{Binding ToolTipText}" ToolTipService.InitialShowDelay="900">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="阅读" Click="TileMenuOpen_Click" />
                        <MenuItem Header="在列表模式中打开" Click="TileMenuList_Click" />
                        <Separator />
                        <MenuItem Header="在资源管理器中显示" Click="TileMenuExplorer_Click" />
                        <Separator />
                        <MenuItem Header="删除" Click="TileMenuDelete_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
                <StackPanel Width="180">
                    <Grid Width="180" Height="252">
                        <Border CornerRadius="6" Background="{StaticResource CardBrush}">
                            <TextBlock x:Name="Placeholder" Text="&#xE8B9;" FontFamily="{StaticResource IconFont}" FontSize="34"
                                       Foreground="{StaticResource FaintTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Image Source="{Binding Cover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,180,252" RadiusX="6" RadiusY="6" />
                            </Image.Clip>
                        </Image>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6"
                                Background="#C8000000" CornerRadius="4" Padding="5,1,5,2">
                            <TextBlock Text="{Binding KindLabel}" FontSize="10" Foreground="#FFEDEDED" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Title}" Margin="2,8,2,0" FontSize="13" Height="38"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               LineHeight="19" LineStackingStrategy="BlockLineHeight" />
                    <TextBlock Text="{Binding Subtitle}" Margin="2,2,2,0" FontSize="11" Height="16"
                               Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding CoverFailed}" Value="True">
                    <Setter TargetName="Placeholder" Property="Text" Value="&#xE783;" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="RowTemplate" DataType="{x:Type lib:TileRow}">
            <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource TileTemplate}"
                          Focusable="False" Height="{x:Static views:LibraryView.RowHeight}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="FavoriteTemplate" DataType="{x:Type views:FavoriteEntry}">
            <Grid ToolTip="{Binding Path}" Background="Transparent">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="以列表模式打开" Click="FavoriteMenuList_Click" />
                        <MenuItem Header="重新扫描" Click="FavoriteMenuRescan_Click" />
                        <MenuItem Header="在资源管理器中打开" Click="FavoriteMenuExplorer_Click" />
                        <Separator />
                        <MenuItem Header="移除收藏" Click="FavoriteMenuRemove_Click" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="14"
                           Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Button x:Name="RemoveButton" Grid.Column="2" Style="{StaticResource IconButton}" Width="22" Height="22" FontSize="9"
                        Margin="4,-2,-4,-2" Content="&#xE711;" ToolTip="移除收藏" Click="RemoveFavorite_Click" Visibility="Hidden" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：打开 + 收藏夹 -->
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,22,16,16" Orientation="Horizontal">
                    <Image Source="/Assets/ezViewer.ico" Width="34" Height="34" Margin="0,0,11,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ezViewer" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="便携漫画阅读器" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="10,0,10,4">
                    <Button Style="{StaticResource NavButton}" Click="OpenFolder_Click" ToolTip="以列表模式打开一个文件夹 (Ctrl+O)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Text="打开文件夹" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="OpenFile_Click" ToolTip="打开压缩包、PDF 或图片 (Ctrl+Shift+O)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Text="打开文件" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <DockPanel DockPanel.Dock="Top" Margin="22,14,12,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12"
                            Content="&#xE710;" ToolTip="添加收藏目录" Click="AddFavorite_Click" />
                    <TextBlock Text="收藏夹" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" />
                </DockPanel>

                <Button DockPanel.Dock="Bottom" Style="{StaticResource NavButton}" Margin="10,6,10,12" Click="Help_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE897;" FontFamily="{StaticResource IconFont}" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="快捷键 (F1)" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Grid>
                    <ListBox x:Name="FavoritesList" Style="{StaticResource DarkListBox}"
                             ItemContainerStyle="{StaticResource DarkListBoxItem}"
                             ItemTemplate="{StaticResource FavoriteTemplate}"
                             SelectionChanged="FavoritesList_SelectionChanged" />
                    <TextBlock x:Name="NoFavoritesText" Text="点击「＋」添加漫画目录" Foreground="{StaticResource FaintTextBrush}"
                               Margin="22,4,16,0" TextWrapping="Wrap" VerticalAlignment="Top" IsHitTestVisible="False" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- 右侧：封面网格 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="24,18,20,12">
                <StackPanel x:Name="ToolbarActions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Width="200" Margin="0,0,12,0"
                             InputMethod.IsInputMethodEnabled="True"
                             Tag="搜索名称 (Ctrl+F)" TextChanged="SearchBox_TextChanged" />
                    <Border Background="{StaticResource PanelAltBrush}" CornerRadius="7" Padding="3" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="SequentialRadio" Style="{StaticResource SegmentRadio}" Content="顺序" GroupName="ComicOrder"
                                         Checked="Order_Checked" ToolTip="阅读时按目录顺序切换上一本 / 下一本" />
                            <RadioButton x:Name="RandomRadio" Style="{StaticResource SegmentRadio}" Content="随机" GroupName="ComicOrder"
                                         Checked="Order_Checked" ToolTip="阅读时打乱左侧列表的顺序（封面顺序不变）" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="重新扫描 (F5)" Click="Refresh_Click" />
                    <Button x:Name="RandomReadButton" Style="{StaticResource AccentButton}" Margin="10,0,0,0" Click="RandomRead_Click"
                            ToolTip="从当前列表中随机打开一本">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B1;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="随机读一本" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="HeaderTitle" Text="书库" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="HeaderStatus" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>

            <ItemsControl x:Name="TileGrid" Grid.Row="1" ItemTemplate="{StaticResource RowTemplate}" Focusable="False"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLengthUnit="Page" VirtualizingPanel.CacheLength="1,1"
                          ScrollViewer.CanContentScroll="True" Padding="14,0,4,16" SizeChanged="TileGrid_SizeChanged">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer x:Name="PART_Scroll" Focusable="False" CanContentScroll="True"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                      Padding="{TemplateBinding Padding}" PreviewMouseWheel="Scroll_PreviewMouseWheel"
                                      views:AutoScroll.IsEnabled="True">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="24,0,24,60" MaxWidth="480">
                <TextBlock x:Name="EmptyIcon" Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="46"
                           Foreground="{StaticResource FaintTextBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyTitle" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Margin="0,16,0,8" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="EmptyText" Foreground="{StaticResource SubtleTextBrush}" TextAlignment="Center"
                           TextWrapping="Wrap" LineHeight="22" />
                <StackPanel x:Name="EmptyActions" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Style="{StaticResource AccentButton}" Content="添加收藏目录" Click="AddFavorite_Click" Margin="0,0,10,0" />
                    <Button Style="{StaticResource FlatButton}" Content="打开文件夹" Click="OpenFolder_Click" Padding="14,7"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
